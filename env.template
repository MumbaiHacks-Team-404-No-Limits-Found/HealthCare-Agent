# Environment Variables for Healthcare Agent Deployment

# ============================
# Security Settings (REQUIRED)
# ============================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# ============================
# Twilio Settings (Optional)
# ============================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=your_twilio_content_template_sid

# ============================
# NotificationAPI Settings (Optional - Alternative to Twilio)
# ============================
NOTIFICATIONAPI_CLIENT_ID=your_notificationapi_client_id
NOTIFICATIONAPI_CLIENT_SECRET=your_notificationapi_client_secret

# ============================
# Database Settings (Optional - Defaults are set)
# ============================
# MONGO_URI=mongodb://mongodb:27017/agentic_volunteer
# DATABASE_NAME=agentic_volunteer
# REDIS_URL=redis://redis:6379/0

# ============================
# API Settings (Optional)
# ============================
# CORS_ORIGINS=http://localhost:3000
# RATE_LIMIT_PER_MINUTE=60
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT_ALGORITHM=HS256

# ============================
# LLM Settings (🌟 NEW: Intelligent Volunteer Queueing)
# ============================
# OpenAI API key for GPT models
OPENAI_API_KEY=your_openai_api_key

# Anthropic API key for Claude (optional alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key

# LLM provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# Model to use (gpt-3.5-turbo, gpt-4, gpt-4-turbo-preview, claude-3-sonnet-20240229)
LLM_MODEL=gpt-3.5-turbo

# Enable/disable LLM-powered volunteer queueing
ENABLE_LLM_QUEUEING=true

# ============================
# Frontend Settings
# ============================
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql

